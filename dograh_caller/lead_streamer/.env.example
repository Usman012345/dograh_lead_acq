# Lead Streamer configuration
# Precedence: environment variables -> .env (in this directory) -> defaults

# Public HTTPS base URL for Host header validation and startup ping_url logging.
# Leave empty or commented out to skip the Host check during local testing.
# Default (set at the top of lead_streamer.py): https://ai-sdr.grobots.ai
# PUBLIC_BASE_URL=https://ai-sdr.grobots.ai
# An empty value (PUBLIC_BASE_URL=) turns the host check off, e.g. when the caller connects by IP.

# PostgreSQL connection URL (required). The scraper's database is "dataops" in the
# dataops_db container, published on 127.0.0.1:5432.
# Accepts both postgresql:// and postgresql+psycopg:// forms.
DATABASE_URL=postgresql://postgres:change_me@127.0.0.1:5432/dataops

# Shared bearer token for the dograh caller (required, minimum 32 characters).
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
STREAM_TOKEN=replace-with-at-least-32-character-secret-token

# HTTP bind host and port (keep 127.0.0.1 behind nginx TLS termination).
BIND_HOST=127.0.0.1
BIND_PORT=8090

# Leads returned per GET /leads/next ping (1..1000; values > 1000 clamp to 1000).
# The dograh caller processes 300 per batch (its LEAD_BATCH_SIZE), so keep these equal.
BATCH_SIZE=300

# Maximum concurrent HTTP requests handled at once (excess requests receive 503).
MAX_CONCURRENT_REQUESTS=8

# PostgreSQL per-statement timeout in milliseconds.
DB_STATEMENT_TIMEOUT_MS=15000

# Per-client socket timeout in seconds.
REQUEST_TIMEOUT_SECONDS=30

# Logging level: DEBUG, INFO, WARNING, or ERROR.
LOG_LEVEL=INFO
