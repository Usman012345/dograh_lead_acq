[Unit]
Description=Lead streamer (hands scraper leads to the dograh caller)
After=network-online.target docker.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=lead-streamer
Group=lead-streamer
WorkingDirectory=/opt/lead_streamer
ExecStart=/opt/lead_streamer/.venv/bin/python lead_streamer.py
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=25
MemoryMax=300M
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true

[Install]
WantedBy=multi-user.target
