# Copy this file to ".env" in this folder and fill it in. (A .env in the parent
# folder is read only when this folder has none - the two are never mixed.)
# .env holds secrets and is git-ignored - never commit it.
# Relative paths below are relative to this folder, wherever you start the program.
# true/false settings accept true/false, yes/no, on/off or 1/0.

# --- Required ------------------------------------------------------------------
# Gemini API key (GEMINI_API also works as an alias)
GEMINI_API_KEY=
# Dograh API key - from the SAME deployment as DOGRAH_BASE_URL
DOGRAH_API_KEY=
DOGRAH_BASE_URL=https://dograh.grobots.ai/api/v1

# --- Optional (defaults shown) -------------------------------------------------
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING_LEVEL=MEDIUM
# GEMINI_TIMEOUT_SECONDS=60
# GEMINI_MAX_ATTEMPTS=4
# INTEREST_THRESHOLD=0.80
# LEAD_MAX_FIELD_CHARS=2000
# LEAD_MAX_STATE_CHARS=12000
# PIPELINE_TRACKER_FILE=output/pipeline_tracker.xlsx
# TRACKER_SAVE_SECONDS=3
# TRACKER_WARN_ROWS=20000
# TRACKER_ARCHIVE_DAYS=30              # finished rows older than this move to pipeline_tracker_archive.xlsx (0 = never)
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8090
# DASHBOARD_REFRESH_SECONDS=5
# ALLOWED_PHONE_REGIONS=US            # e.g. US,PR,VI,GU,MP,AS to include US territories
# SKIP_ALREADY_CALLED=true             # never re-call numbers called in earlier runs
# LEAD_BATCH_SIZE=300
# DECISION_CONCURRENCY=8
# QUEUE_MAXSIZE=100
# CAMPAIGN_NAME_DATE_FORMAT=%Y-%m-%d
# CAMPAIGN_RETRY_ENABLED=true
# CAMPAIGN_MAX_RETRIES=1
# CAMPAIGN_RETRY_DELAY_SECONDS=120
# CAMPAIGN_RETRY_ON_BUSY=true
# CAMPAIGN_RETRY_ON_NO_ANSWER=true
# CAMPAIGN_RETRY_ON_VOICEMAIL=false
# CAMPAIGN_POLL_SECONDS=5
# CAMPAIGN_IDLE_TIMEOUT_SECONDS=900
# CAMPAIGN_MAX_CALL_SECONDS=3600       # a call still going counts as progress until it is this old
# STOP_SYNC_SECONDS=2                  # after Stop: wait, then record calls Dograh started at that moment
# RESULT_WAIT_SECONDS=20
# RETRY_GRACE_SECONDS=120
# NOT_REACHED_DISPOSITIONS=busy,no-answer,no_answer,failed,error,canceled,cancelled,voicemail,machine
# RETRY_FAILED_CALLS=false             # call leads that reached nobody again in a later batch
# RETRY_MAX_ATTEMPTS=3                 # most times one lead is saved for a retry (Gemini or call)
# RECOVER_CALLS_DAYS=7                 # on start, fetch results of calls an earlier run stopped during (0 = off)
# DOGRAH_SEND_ALL_FIELDS=false         # true = send every lead field to the agent (old behaviour)
# DOGRAH_EXTRA_FIELDS=company,company_name,business_name,contact_name,contact_title,category,industry,city,state,location,lead_id
# RESULTS_MAX_LEAD_COLUMNS=80
# RESULTS_FILE=output/call_results.xlsx
# RESULTS_SAVE_SECONDS=15              # results files are rewritten at most this often during a run
# TRANSFERS_FILE=output/transferred_calls.xlsx   # businesses whose call was transferred
# TRANSFER_DISPOSITIONS=transfer_call,call_transferred

# --- Lead source (pull_leads.py) ---------------------------------------------
# The lead streamer's STREAM_TOKEN (same value as in lead_streamer/.env on the
# scraper server). STREAM_TOKEN also works as the name.
LEAD_SOURCE_TOKEN=
# LEAD_SOURCE_URL=https://ai-sdr.grobots.ai
# LEAD_SOURCE_TIMEOUT=180
# PULLED_BATCHES_DIR=output/pulled_batches
